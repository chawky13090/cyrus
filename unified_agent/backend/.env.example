# Flask Configuration
FLASK_APP=main:app
FLASK_ENV=development # development or production
FLASK_RUN_PORT=5050 # Port for the backend Flask app
SECRET_KEY=your_very_secret_flask_key_here # Change this!

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3 # Default model to use for chat

# ChromaDB Configuration
CHROMA_DB_PATH=./unified_agent_chroma_db # Path relative to backend directory

# Logging Configuration
LOG_LEVEL=INFO # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=../logs/backend.log # Path relative to backend directory, goes into unified_agent/logs/

# Basic Authentication
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=changeme # Strongly recommend changing this
BASIC_AUTH_ENABLED=True # True or False
